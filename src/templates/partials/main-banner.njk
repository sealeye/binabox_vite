<section class="main-banner">

    <div class="main-banner__illustration">
        <img
            class="main-banner__img main-banner__img--third"
            src="/src/assets/images/main-banner-3.png?format=avif"
            alt=""
        >
        <img
            class="main-banner__img main-banner__img--second"
            src="/src/assets/images/main-banner-2.png?format=avif"
            alt=""
        >
        <img
            class="main-banner__img main-banner__img--first"
            src="/src/assets/images/main-banner-1.png?format=webp"
            alt=""
        >


        <img
            class="main-banner__img main-banner__img--fourth"
            src="/src/assets/images/pen.svg"
            alt=""
        >

        {% macro picture(src, classes) %}
        <picture class="{{ classes }}">
            <source srcset="{{ src }}?format=webp"
                type="image/webp"
            >
            <source srcset="{{ src }}?format=avif"
                type="image/avif"
            >
            <img
                class="main-banner__img main-banner__img--fifth"
                src="{{ src }}?format=webp"
                alt=""
            >
        </picture>
        {% endmacro %}

        {{ picture('/src/assets/images/main-banner-1.png', 'main-banner__img main-banner__img--fifth') }}



        {#
        <img
            class="main-banner__img main-banner__img--fifth"
            src="/src/assets/images/color-pallet.svg"
            alt=""
        >
        #}
        {#        {{ icon('pen', 'main-banner__img main-banner__img--fourth') }} #}

        <svg class="main-banner__img main-banner__img--fifth">
            <use href="/src/assets/sprite.svg#icon-pen"/>
        </svg>
    </div>

    <div class="main-banner__content">
        <h1 class="main-banner__title">Craft Your Success with Our Digital Assets</h1>

        <p class="main-banner__subtitle">From our inspiring illustrations to dynamic UI/UX kits, elevate your projects
            with
            our premium digital design resources.</p>

        <button>
            Shop now
        </button>

        <button>
            Watch about us
        </button>
    </div>

</section>