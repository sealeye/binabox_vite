<a href="{{ item.link }}">
	<article class="item-card">
		<img class="item-card__image" src="{{ item.image }}" alt="{{ item.image_alt }}">
		<span class="item-card__label item-card__label--{{ item.state }}">{{ item.label }}</span>
		<p class="item-card__price">{{ item.price }}</p>
		<h3 class="item-card__name">{{ item.name }}</h3>
	</article>
</a>
