<section class="catalog-slider">
	<header class="catalog-slider__header">
		<h2 class="catalog-slider__title">{{ catalog_section.title }}</h2>
		<a class="catalog-slider__link button" href="{{ catalog_section.link.action }}">{{ catalog_section.link.text }}</a>
		<button class="catalog-slider__nav-button button"></button>
		<button class="catalog-slider__nav-button button"></button>
	</header>
	<ul class="catalog-slider-list">
		{% for item in catalog_cards %}
			<li class="catalog-slider-list__item">
				{% include 'item-card.twig' %}
			</li>
		{% endfor %}
	</ul>
</section>
