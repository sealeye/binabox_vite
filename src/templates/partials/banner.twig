<section class="banner">
  <h1 class="banner__heading">WITH <span class="banner__highlight">{{ banner_title }}</span> EXPLORE NFT COLLECTION!</h1>
  <p class="banner__text">
          We are the best way to check for the rarity of your NFT
          <span class="banner__highlight">{{ banner_title }}</span>
  </p>
  <div class="banner__stats">
    <p class="banner__stat-label">Total IT Team</p>
    <p class="banner__stat-value">2200+</p>
    <p class="banner__stat-label">Profiles Whitelisted</p>
    <p class="banner__stat-value">1000+</p>
  </div>
  <div class="banner__button-group">
    <a class="banner__button" href="#">Connect Wallet</a>
    <a class="banner__button" href="#">Whitelist Now</a>
  </div>
</section>

