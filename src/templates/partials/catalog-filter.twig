{% from 'ui/icon.twig' import icon %}

<button class="button catalog-page__filter-button" type="button">
	Filters
	{{ icon('catalog-page__filter-button-icon', 'filter-lines') }}
	{{ icon('catalog-page__filter-button-close', 'close') }}
</button>
<form action="#" method="post" class="catalog-filter">
	{% for item in catalog.filter %}
		<details class="filter-fieldset">
			<summary class="filter-fieldset__title">{{ item.title }}</summary>
			<ul class="filter-fieldset__list">
				{% for input in item.list %}
					<li class="filter-fieldset__list-item">
						{% include 'ui/input.twig' %}
					</li>
				{% endfor %}
			</ul>
		</details>
	{% endfor %}
	<button type="submit" class="catalog-filter__button button button--primary">Apply</button>
</form>
