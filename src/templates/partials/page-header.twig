<header class="page-header">
  <a href="index.html" class="logo">
    <img src="img/logo.png" alt="Binabox Logo" class="logo__image"/>
  </a>
  <nav class="main-nav">
    <ul class="main-nav__list">
      {% for item in nav %}
      <li class="main-nav__list-item">
        <a href="{{ item.url }}"
          class="main-nav__link {% if item.url == path %} main-nav__link--active {% endif %}">
          {{ item.text }}</a> 
      </li>
      {% endfor %}
    </ul>
    <form action="#" method="post" class="search-form">
      <label class="input search-form__label">
        <input type="search" class="input__field button search-form__input" placeholder="Search">
      </label>
      <button type="submit" class="visually-hidden">Send</button>
    </form>
    <a class="button page-header__button" href="#" target="_blank" rel="noopener noreferrer">Discord</a>
    <a class="button button--primary page-header__button" href="#" target="_blank" rel="noopener noreferrer">Connect</a>
  </nav>
</header>