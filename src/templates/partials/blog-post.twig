<article class="blog-post">

	<figure class="blog-post__illustration blog-post__illustration--wide">
		<img class="blog-post__illustration-image" src="{{ blog_page.post.main_image.src }}" alt="{{ post.main_image.alt }}">
		<figcaption class="blog-post__illustration-caption">{{ blog_page.post.main_image.caption }}</figcaption>
	</figure>

	<h3 class="blog-post__main-title">{{ blog_page.post.title }}</h3>
	<p class="blog-post__label button button--primary">{{ blog_page.post.category }}</p>

	<div class="blog-post__meta">
		<p>{{ blog_page.post.author }}</p>
		<time datetime="{{ blog_page.post.date_iso }}">{{ blog_page.post.date_human }}</time>
	</div>

	<p class="blog-post__text">The Basilisks that
		<span class="hightlight">players</span>
		collect are represented with NFTs on Ethereum’s blockchain with real-world value. Players use the
		<span>Basilisks they have</span>
		gathered to battle other players to win ether (ETH).</p>
	<p class="blog-post__text">In Balthazar Dragons, players are immersed in a 3D open world to explore and capture dragon-like beasts called Basilisks.  Balthazar Dragons is an upcoming fantasy role-playing game developed on the Ethereum blockchain by a decentralized autonomous organization (DAO) called the Balthazar DAO.</p>

	<ul class="blog-post__unordered-list">
		{% for item in blog_page.post.bullets %}
			<li>{{ item }}</li>
		{% endfor %}
	</ul>

	<ol class="blog-post__unordered-list">
		{% for item in blog_page.post.ordered %}
			<li>{{ item }}</li>
		{% endfor %}
	</ol>

	{% include 'ui/blockquote.twig' with { item: blog_page.post.blockquote } %}

	{% for image in blog_page.post.additional_images %}
		<figure class="blog-post__illustration">
			<img class="blog-post__illustration-image" src="{{ image.src }}" alt="{{ image.alt }}">
			<figcaption class="blog-post__illustration-caption">{{ image.caption }}</figcaption>
		</figure>
	{% endfor %}

	{% for section in blog_page.post.sections %}
		<h4 class="blog-post__subtitle">{{ section.title }}</h4>
		{% for paragraph in section.text %}
			<p class="blog-post__text">{{ paragraph }}</p>
		{% endfor %}
	{% endfor %}

	<p class="blog-post__text">Tags:</p>
	<ul>
		{% for tag in blog_page.post.tags %}
			<li>
				<a class="button button--small" href="{{ tag.url }}">{{ tag.text }}</a>
			</li>
		{% endfor %}
	</ul>

	<p class="blog-post__text">Share:</p>
	<ul>
		{% for item in blog_page.post.share %}
			<li>
				<a class="button button--small" href="{{ item.url }}">{{ item.label }}</a>
			</li>
		{% endfor %}
	</ul>
</article>
