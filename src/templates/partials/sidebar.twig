<aside class="sidebar">
  <div class="sidebar__section">
    <h3 class="sidebar__section-title">{{ sidebar.categories_title }}</h3>
    <ul class="sidebar__section-list">
      {% for category in sidebar.categories %}
        <li class="sidebar__section-list-item">
          <a class="sidebar__section-link" href="{{ category.url }}">
            {{ category.name }} ({{ category.count }})
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>

  <div class="sidebar__section">
    <h3 class="sidebar__section-title">{{ sidebar.tags_title }}</h3>
    <ul class="sidebar__section-tags">
      {% for tag in sidebar.tags %}
        <li class="sidebar__section-tags-item">
          <a class="sidebar__section-tags-link button button--small" href="{{ tag.url }}">
            {{ tag.name }}
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</aside>
