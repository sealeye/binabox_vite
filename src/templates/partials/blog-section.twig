<section class="blog-section">
	<h2 class="blog-section__title main-title">{{ blog_section.title }}</h2>
	<ul class="blog-section__list content-wrapper content-wrapper--wide">
		{% for item in blog_items %}
			<li class="blog-section__list-item">
				{% include 'blog-card.twig' %}
			</li>
		{% endfor %}
	</ul>
	<button class="blog-section__button button" type="button">{{ about_section.button.text }}</button>
</section>
